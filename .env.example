# --- App ---
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# --- Database ---
# Defaults to local SQLite file. Swap for a Postgres URL in production.
DATABASE_URL=sqlite:///./autotriage.db

# --- GitHub ---
# Personal Access Token with repo scope (Contents: read, Pull requests: write)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Format: owner/repo
GITHUB_REPO=

# --- LLM (AutoTriage triage engine) ---
# Provider: "openai" | "anthropic"
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Additional LLM API Keys (for graphify and tooling) ---
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# --- NVIDIA OpenAI-compatible endpoint (optional, swap LLM_PROVIDER=openai) ---
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
