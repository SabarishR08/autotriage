# AutoTriage — environment variable reference
# Copy to .env for local dev: cp .env.example .env
# For production (Render): set these in the dashboard. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---
APP_ENV=development          # "development" | "production"
HOST=0.0.0.0
PORT=8000

# --- Database ---
# SQLite for local dev (default). Swap to a Postgres URL for production.
# Render injects DATABASE_URL automatically from the linked Postgres instance.
# Postgres format: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./autotriage.db

# --- GitHub ---
# Fine-grained PAT with Contents: read/write + Pull requests: read/write
# Scoped to only the target repo. Generate at:
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
# Format: owner/repo  (e.g. SabarishR08/autotriage-testbed)
GITHUB_REPO=

# --- LLM (AutoTriage triage engine) ---
# Provider: "openai" | "anthropic"
# OpenAI-compatible providers (Groq, NVIDIA NIM) use LLM_PROVIDER=openai
# and set OPENAI_API_BASE to the provider's base URL.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# OpenAI-compatible base URL (leave blank to use api.openai.com)
# Groq:       https://api.groq.com/openai/v1
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
OPENAI_API_BASE=https://api.groq.com/openai/v1

# --- Additional LLM API Keys (tooling, graphify) ---
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Leave as * for local dev. MUST be set to real domain(s) in production.
# Example: https://autotriage.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# --- Ingestion auth ---
# Set to require X-API-Key header on POST /api/v1/logs.
# Leave blank for open access (dev/internal only).
# In production this MUST be set (validate() will warn if unset).
AUTOTRIAGE_API_KEY=
